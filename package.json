    "@monaco-editor/react": "^4.7.0",
    "@octokit/auth-oauth-device": "^8.0.3",
    "@octokit/rest": "^22.0.1",
    "@parcel/watcher": "^2.5.6",
    "@tanstack/react-form": "^1.28.4",
    "@tanstack/react-hotkeys": "^0.4.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.23",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-collaboration": "^3.22.5",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/extension-typography": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/suggestion": "^3.22.5",
    "@tiptap/y-tiptap": "^3.0.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ssh2": "^1.15.5",
    "@workos-inc/node": "^9.2.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "better-sqlite3": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "devicon": "^2.17.0",
    "docx-preview": "^0.4.1",
    "drizzle-orm": "^0.32.1",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.27.7",
    "glob": "^13.0.6",
    "ignore": "^5.3.1",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.564.0",
    "marked": "16.4.2",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-mdx": "3.0.0",
    "mdx-bundler": "^10.1.1",
    "mermaid": "^11.16.0",
    "micromark-extension-mdxjs": "3.0.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.23.12",
    "node-pty": "1.1.0",
    "parse5": "7.3.0",
    "posthog-js": "^1.297.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.3",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^2.15.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.6.0",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^2.6.0",
    "tippy.js": "^6.3.7",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "ssh2"
    ],
    "overrides": {
      "dompurify@3": "^3.4.17",
      "fast-uri@3": "^3.1.7",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "lodash@4": "^4.18.1",
      "lodash-es@4": "^4.18.1",
      "shell-quote@1": "^1.9.0",
      "toml@<5.0.1": "^5.0.1"
    }
  }
}

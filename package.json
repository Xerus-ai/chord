{
  "name": "chord",
  "version": "0.1.0",
  "description": "A multiplayer desktop workspace where dev teams align and AI agents build",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "d": "pnpm install && pnpm run dev",
    "build:protocol": "pnpm --filter @chord/protocol run build",
    "dev": "pnpm run build:protocol && concurrently -n electron,server -c blue,green \"electron-vite dev\" \"cd server && npx tsx watch src/index.ts\"",
    "dev:electron": "electron-vite dev",
    "dev:server": "cd server && npx tsx watch src/index.ts",
    "dev:debug": "VITE_LOG_LEVEL=debug electron-vite dev",
    "dev:main": "electron-vite dev --watch main",
    "dev:renderer": "electron-vite dev --watch renderer",
    "db:generate": "drizzle-kit generate",
    "codex:protocol": "node scripts/generate-codex-protocol.mjs",
    "db:reset": "rm -f \"$HOME/Library/Application Support/chord/chord.db\" \"$HOME/Library/Application Support/chord/chord.db-wal\" \"$HOME/Library/Application Support/chord/chord.db-shm\" \"$HOME/.config/chord/chord.db\" \"$HOME/.config/chord/chord.db-wal\" \"$HOME/.config/chord/chord.db-shm\"",
    "test": "pnpm run build:protocol && vitest run --project node --project node-lane-runs --project node-solo --project server --project browser",
    "test:codex": "pnpm run build:protocol && vitest run --project node-codex",
    "build": "pnpm run build:protocol && electron-vite build",
    "build:main": "electron-vite build --filter main",
    "build:renderer": "electron-vite build --filter renderer",
    "package": "pnpm run build && electron-builder --config electron-builder.config.ts",
    "package:mac": "pnpm run build && electron-builder --mac --config electron-builder.config.ts",
    "package:linux": "pnpm run build && electron-builder --linux --publish never --config electron-builder.config.ts",
    "package:win": "pnpm run build && electron-builder --win --publish never --config electron-builder.config.ts",
    "postinstall": "pnpm run build:protocol && node --experimental-strip-types scripts/postinstall.ts",
    "rebuild": "electron-rebuild -f -v 40.10.6 --only=better-sqlite3,node-pty",
    "run:docker-ssh": "docker compose up --build -d",
    "clean": "rm -rf node_modules dist",
    "reset": "pnpm run clean && pnpm install",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache && pnpm run lint:tokens && pnpm run format:check",
    "lint:tokens": "node scripts/token-audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run build:protocol && tsc --noEmit && tsc --noEmit -p scripts/release/tsconfig.json && tsc --noEmit -p server"
  },
  "keywords": [
    "electron",
    "coding-agents",
    "git",
    "claude",
    "openai"
  ],
  "author": {
    "name": "Chord Contributors",
    "email": "support@xerus.ai"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.28.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/browser-preview": "^4.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.24.2",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.32",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "s3mini": "^0.9.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.0",
    "vitest-browser-react": "^2.1.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.265",
    "@base-ui/react": "^1.3.0",
    "@chord/protocol": "workspace:*",

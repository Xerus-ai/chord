# Chord Electron App — Environment Variables
# Copy to .env and fill in values

# WorkOS Authentication (required in packaged builds)
WORKOS_CLIENT_ID=client_xxx
WORKOS_REDIRECT_URI=http://localhost:1234/auth/callback
WORKOS_AUTHKIT_URL=https://your-tenant.authkit.app

# GitHub OAuth (required in packaged builds)
GITHUB_OAUTH_CLIENT_ID=Ov23xxx

# Auth Server (required in packaged builds)
CHORD_AUTH_SERVER_URL=https://sync.example.com

# Cloud API (required in packaged builds)
CHORD_CLOUD_API_URL=https://sync.example.com

# Public-facing URLs (required in packaged builds)
CHORD_RELEASES_URL=https://xerus.ai/chord/releases
CHORD_DOCS_URL=https://xerus.ai/chord/docs
CHORD_TERMS_URL=https://xerus.ai/chord/terms
CHORD_PRIVACY_URL=https://xerus.ai/chord/privacy
CHORD_ISSUES_URL=https://github.com/Xerus-ai/chord/issues

# Feedback modal delivery webhook (optional — feedback submission is disabled when unset).
# Secret: main-process only, never exposed to the renderer.
# CHORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Auto-updater R2 bucket URL (optional — defaults to https://releases.xerus.ai)
# R2_BASE_URL=https://releases.xerus.ai

# Vite renderer env (injected at build time via electron.vite.config.ts)
VITE_CLOUD_API_URL=https://sync.example.com
VITE_CLOUD_WS_URL=wss://sync.example.com/ws
VITE_COLLAB_WS_URL=wss://sync.example.com:1235

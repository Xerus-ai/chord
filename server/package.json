{
  "name": "@chord/sync-server",
  "version": "0.1.0",
  "description": "Chord cloud sync server — real-time collaboration, presence, and data sync",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:protocol && tsx watch src/index.ts",
    "build": "pnpm run build:protocol && tsc",
    "build:protocol": "pnpm --filter @chord/protocol run build",
    "start": "node dist/index.js",
    "typecheck": "pnpm run build:protocol && tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "lint": "eslint src/ --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@chord/protocol": "workspace:*",
    "@hocuspocus/server": "^4.0.0",
    "@neondatabase/serverless": "^0.10.4",
    "@polar-sh/sdk": "^0.49.0",
    "@workos-inc/node": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.39.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "jose": "^6.2.3",
    "standardwebhooks": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "yjs": "^13.6.30"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2"
  }
}

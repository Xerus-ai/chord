# Chord Cloud Sync Server — Environment Variables
# Copy to .env and fill in values

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/chord?sslmode=require

# WorkOS
WORKOS_API_KEY=sk_test_xxx
WORKOS_CLIENT_ID=client_xxx

# Server
PORT=1234
HOCUSPOCUS_PORT=1235
NODE_ENV=production

# Local development only: bypasses WorkOS auth (every request becomes an
# admin dev user). Requires NODE_ENV to NOT be "production". Leave unset
# (or set WORKOS_CLIENT_ID above with real credentials) otherwise — the
# server refuses to start if neither is provided.
# DEV_MODE=true

# Comma-separated list of extra allowed CORS origins (e.g. a staging
# renderer). The packaged Electron app's app:// origin and the local
# electron-vite dev server are always allowed and don't need to be listed.
# ALLOWED_ORIGINS=https://staging.example.com

# Set to 1 (one reverse proxy in front of this process — the topology
# DEPLOYMENT.md documents) when deploying behind Caddy/nginx/a load balancer.
# Without it, every caller's IP resolves to the proxy's own address and the
# IP-keyed rate limiters (middleware/rate-limit.ts) treat every distinct
# caller as one shared bucket. Leave unset for local dev (server sees the
# client's TCP connection directly). Positive integer hop count, or 'true'
# to trust the nearest hop unconditionally.
# TRUST_PROXY=1

# Polar team billing (leave unset to run without billing — every org stays on
# the free plan with 5 seats). Use a DEDICATED Polar organization for Chord;
# never share Xerus's (its email-based subscription sync would cross-
# contaminate the two apps' customers).
# POLAR_ACCESS_TOKEN=polar_oat_xxx
# POLAR_WEBHOOK_SECRET=whsec_xxx
# POLAR_ENVIRONMENT=sandbox
# Product ids of the seat-based Pro subscription (Polar dashboard -> Products).
# POLAR_PRODUCT_PRO_MONTHLY=00000000-0000-0000-0000-000000000000
# POLAR_PRODUCT_PRO_ANNUAL=00000000-0000-0000-0000-000000000000
# Max purchasable seats on the pro plan (default 50). Larger teams = custom plan.
# POLAR_PRO_SEAT_LIMIT=50

# Domain — the server's public origin. Public artifact links are built from it.
SYNC_SERVER_URL=https://sync.example.com

# Public artifact links (P6): HMAC key for link tokens. Generate with
# `openssl rand -base64 48`. Rotating it invalidates every public link.
SHARE_LINK_SECRET=
